generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                    String                  @id @default(uuid())
  name                  String
  phone                 String
  email                 String                  @unique
  status                Boolean
  dueDate               DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now())
  subscriptionPlanId    String?
  superAdmin            Boolean?                @default(false)
  SubscriptionPlan      SubscriptionPlan?       @relation(fields: [subscriptionPlanId], references: [id])
  subscriptions         CompanySubscription[]
  Configuration         Configuration?
  contactList           ContactList[]
  contacts              Contact[]
  ConversationInstagram ConversationInstagram[]
  conversations         Conversation[]
  instagramProfile      InstagramProfile?
  MessageInstagram      MessageInstagram[]
  messages              Message[]
  prompts               Prompts[]
  queues                Queue[]
  quickResponses        QuickResponse[]
  tags                  Tags[]
  ToDo                  ToDo[]
  users                 User[]

  @@map("company")
}

model CompanySubscription {
  id            String             @id @default(uuid())
  companyId     String
  planId        String
  startDate     DateTime           @default(now())
  endDate       DateTime?
  status        SubscriptionStatus @default(ACTIVE)
  paymentStatus PaymentStatus      @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  company       Company            @relation(fields: [companyId], references: [id])
  plan          SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@map("company_subscriptions")
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String                  @unique
  role                   UserRole                @default(ADMIN)
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now())
  password               String
  companyId              String
  connectionId           String?
  phone                  String
  tokenIg                String?
  instagramId            String?
  instagramAuthenticated Boolean?                @default(false)
  WhatsAppConnection     WhatsAppConnection[]
  Contact                Contact[]
  ConversationInstagram  ConversationInstagram[]
  conversations          Conversation[]
  instagramProfile       InstagramProfile?
  MessageInstagram       MessageInstagram[]
  messages               Message[]
  notes                  Note[]
  queues                 QueueUser[]
  todosCreated           ToDo[]                  @relation("ToDoCreator")
  todosResponsible       ToDo[]                  @relation("ToDoResponsible")
  company                Company                 @relation(fields: [companyId], references: [id])

  @@map("users")
}

model Contact {
  id            String                 @id @default(uuid())
  name          String
  phone         String
  email         String?
  tags          String[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime?              @updatedAt
  companyId     String
  userId        String?
  image         String?
  isCustomer    Boolean?               @default(true)
  triggerStatus TriggerStatus?         @default(WAITING)
  contactLists  ContactListOnContact[]
  Company       Company                @relation(fields: [companyId], references: [id])
  User          User?                  @relation(fields: [userId], references: [id])
  conversations Conversation[]
  notes         Note[]

  @@map("contacts")
}

model ContactList {
  id          String                 @id @default(uuid())
  name        String
  description String?
  isActive    Boolean
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  companyId   String
  campaign    Campaign?
  Company     Company                @relation(fields: [companyId], references: [id])
  contacts    ContactListOnContact[]

  @@map("contact_list")
}

model ContactListOnContact {
  contactId     String
  contactListId String
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)

  @@id([contactId, contactListId])
  @@map("contact_list_on_contact")
}

model Note {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  contactId String
  userId    String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("notes")
}

model Campaign {
  id            String      @id @default(uuid())
  body          String
  title         String?
  imageUrl      String?
  footer        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contactListId String      @unique
  contactList   ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

model Queue {
  id                      String                  @id @default(uuid())
  name                    String
  color                   String                  @default("#3B82F6")
  isActive                Boolean                 @default(true)
  priority                Int                     @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  greetingMessage         String?
  integrationId           String?
  outOfOfficeHoursMessage String?
  schedules               Json[]                  @default([])
  companyId               String
  ConversationInstagram   ConversationInstagram[]
  conversations           Conversation[]
  prompts                 PromptQueue[]
  QueueConnection         QueueConnection[]
  users                   QueueUser[]
  Company                 Company                 @relation(fields: [companyId], references: [id])
  quickResponses          QuickResponse[]

  @@map("queues")
}

model QueueConnection {
  id           String             @id @default(uuid())
  queueId      String
  connectionId String
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  queue        Queue              @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@unique([queueId, connectionId])
  @@map("queue_connections")
}

model QueueUser {
  id      String @id @default(uuid())
  userId  String
  queueId String
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, queueId])
  @@map("queue_users")
}

model Conversation {
  id              String             @id @default(uuid())
  contactId       String
  userId          String?
  queueId         String?
  status          ConversationStatus @default(WAITING)
  priority        Priority?          @default(MEDIUM)
  subject         String?
  lastMessageAt   DateTime?
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime?          @updatedAt
  tagId           String?
  companyId       String
  copilot         Boolean?           @default(false)
  copilotIndex    Int?               @default(0)
  copilotFeedback Json?
  statusCopilot   String?
  isInFollowUp    Boolean?           @default(false)
  followUpStart   DateTime?          @db.Timestamptz()
  timeToFolowUp   DateTime?          @db.Timestamptz()
  Company         Company            @relation(fields: [companyId], references: [id])
  contact         Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  queue           Queue?             @relation(fields: [queueId], references: [id])
  tag             Tags?              @relation(fields: [tagId], references: [id])
  user            User?              @relation(fields: [userId], references: [id])
  messages        Message[]

  @@map("conversations")
}

model ConversationInstagram {
  id        String             @id @default(uuid())
  name      String
  username  String
  image     String
  userId    String?
  tagId     String?
  queueId   String?
  companyId String
  updatedAt DateTime?          @updatedAt
  createdAt DateTime           @default(now())
  Company   Company            @relation(fields: [companyId], references: [id])
  queue     Queue?             @relation(fields: [queueId], references: [id])
  tag       Tags?              @relation(fields: [tagId], references: [id])
  user      User?              @relation(fields: [userId], references: [id])
  messages  MessageInstagram[]

  @@map("conversation_ig")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  userId         String?
  content        String
  direction      Direction
  status         MessageStatus @default(PENDING)
  mediaUrl       String?
  mediaType      String?
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  messageType    String
  timestamp      String
  companyId      String
  mediaCaption   String?
  Company        Company       @relation(fields: [companyId], references: [id])
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id])

  @@map("messages")
}

model MessageInstagram {
  id                      String                @id @default(uuid())
  content                 String
  userId                  String?
  direction               Direction
  messageType             String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime?             @updatedAt
  timestamp               String
  companyId               String?
  plataform               String?
  conversationInstagramId String
  permalink               String?
  thumbnailUrl            String?
  Company                 Company?              @relation(fields: [companyId], references: [id])
  ConversationInstagram   ConversationInstagram @relation(fields: [conversationInstagramId], references: [id], onDelete: Cascade)
  user                    User?                 @relation(fields: [userId], references: [id])

  @@map("message-ig")
}

model QuickResponse {
  id        String   @id @default(uuid())
  title     String
  shortcut  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  queueId   String
  message   String
  companyId String
  Company   Company  @relation(fields: [companyId], references: [id])
  queue     Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@map("quick_responses")
}

model Prompts {
  id                   String              @id @default(uuid())
  title                String
  apiKey               String
  prompt               String
  maxTokens            Int
  maxMessages          Int
  promptTokens         Int?
  completionTokens     Int?
  totalTokens          Int?
  temperature          Float?
  assistantId          String?
  description          String?
  companyResume        String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  isActive             Boolean             @default(true)
  companyId            String
  whatsAppConnectionId String?
  isDefault            Boolean?            @default(false)
  isFollowUp           Boolean?            @default(false)
  isInitialPrompt      Boolean?            @default(false)
  isIgCommentPrompt    Boolean?            @default(false)
  isIgDMsPrompt        Boolean?            @default(false)
  queue                PromptQueue[]
  Company              Company             @relation(fields: [companyId], references: [id])
  WhatsAppConnection   WhatsAppConnection? @relation(fields: [whatsAppConnectionId], references: [id])

  @@map("prompts")
}

model PromptQueue {
  id       String  @id @default(uuid())
  promptId String
  queueId  String
  prompt   Prompts @relation(fields: [promptId], references: [id])
  queue    Queue   @relation(fields: [queueId], references: [id])

  @@map("prompt_queue")
}

model Tags {
  id                    String                  @id @default(uuid())
  title                 String
  color                 String
  order                 Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  description           String?
  companyId             String
  ConversationInstagram ConversationInstagram[]
  conversations         Conversation[]
  Company               Company                 @relation(fields: [companyId], references: [id])

  @@map("tags")
}

model ToDo {
  id            String    @id @default(uuid())
  title         String
  description   String?
  completed     Boolean   @default(false)
  priority      Priority
  companyId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  responsibleId String?
  dueDate       DateTime? @db.Date
  Company       Company?  @relation(fields: [companyId], references: [id])
  createdBy     User?     @relation("ToDoCreator", fields: [createdById], references: [id])
  responsible   User?     @relation("ToDoResponsible", fields: [responsibleId], references: [id])

  @@map("todo")
}

model WhatsAppConnection {
  id                      String                   @id @default(uuid())
  name                    String
  isDefault               Boolean
  greetingMessage         String?
  conclusionMessage       String?
  outOfOfficeHoursMessage String?
  reviewMessage           String?
  token                   String?
  queueId                 String?
  integrationId           String?
  userId                  String?
  promptId                String?
  transferQueueId         String?
  timeToTransfer          String?
  expiresInactiveMessage  String?
  companyId               String
  session                 String?
  status                  WhatsAppConnectionStatus @default(PENDING)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime?                @updatedAt
  instanceId              String?
  instanceName            String?
  user                    User?                    @relation(fields: [userId], references: [id])
  prompt                  Prompts[]
  QueueConnection         QueueConnection[]
}

model Configuration {
  id                    String   @id @default(uuid())
  followupTimeInHours   Int      @default(72)
  companyId             String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  businessHours         Json?
  appIdInstagram        String?
  clientIdInstagram     String?
  clientSecretInstagram String?
  tokenInstagram        String?
  Company               Company  @relation(fields: [companyId], references: [id])

  @@map("configurations")
}

model SubscriptionPlan {
  id                  String                @id @default(uuid())
  name                String                @unique
  description         String?
  price               Decimal
  features            Json
  status              PlanStatus            @default(INACTIVE)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  checkoutUrl         String?
  companies           Company[]
  CompanySubscription CompanySubscription[]

  @@map("subscription_plans")
}

model InstagramProfile {
  id             String   @id @default(uuid())
  name           String
  username       String
  image          String?
  followersCount Int
  followsCount   Int
  userId         String?  @unique
  companyId      String?  @unique
  Company        Company? @relation(fields: [companyId], references: [id])
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("instagram_profiles")
}

enum UserRole {
  ADMIN
  USER
  OWNER
}

enum ConversationStatus {
  WAITING
  SERVING
  RESOLVED
  CLOSED
  OPEN
  PENDING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum WhatsAppConnectionStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  PENDING
  EXPIRED
  CANCELLED
  TESTING
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
  TESTING
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  FAILED
}

enum TriggerStatus {
  WAITING
  COMPLETED
  FAILED
}
